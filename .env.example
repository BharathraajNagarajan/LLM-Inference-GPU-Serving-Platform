# Copy this file to .env and fill in values as needed.
# This is a placeholder only — no serving/benchmark logic reads these yet.

# Hugging Face model identifier or local path to serve
MODEL_NAME=

# Port the inference server should listen on
SERVER_PORT=8000

# Maximum number of concurrent requests the server should accept
MAX_CONCURRENCY=

# Hugging Face auth token, if the model is gated
HF_TOKEN=
